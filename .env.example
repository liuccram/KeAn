# 复制为仓库根目录 .env 后按本机修改。不要把真实密钥提交到 Git。
# 三套环境：
#   开发  SPRING_PROFILES_ACTIVE=dev   再复制本文件为 .env.dev
#   测试  SPRING_PROFILES_ACTIVE=test  再复制本文件为 .env.test
#   生产  SPRING_PROFILES_ACTIVE=prod  再复制本文件为 .env.prod
# 启动会先读 .env，再覆盖读 .env.{profile}。具体值写在对应文件里即可。

SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# HS256 密钥，长度至少 32 字节
JWT_SECRET=
JWT_EXPIRE_SECONDS=86400

# 对象存储：RustFS（S3 兼容），已替换掉 MinIO。旧名 MINIO_* 已改名为 STORAGE_*，
# 应用不再读取旧名，改完记得把已有的 .env / .env.dev / .env.test / .env.prod 一起改。
# ENDPOINT 指向 S3 API 端口（9000），不是 Web 控制台端口（9001）。
# 本地 compose 用 http://127.0.0.1:9000；RustFS 装在别的机器上就填那台的地址。
# ACCESS_KEY / SECRET_KEY 必须与 docker-compose 里的 RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY 一致，
# 且不能使用 RustFS 自带的默认值 rustfsadmin。
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=kean

ADMIN_USERNAME=admin
# 不少于 12 位，禁止 ChangeMe_Admin_123
ADMIN_PASSWORD=
ADMIN_NICKNAME=系统管理员

# 必须是明确的前端源，禁止 *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=课安

# 生产必须 false。仅本地没有 SMTP 时才允许把验证码打到控制台
SMS_ALLOW_CONSOLE=false
SMS_EXPOSE_CODE=false

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 仅当前面是 Nginx 等可信反代时填写
TRUSTED_PROXIES=

# ── 字段加密密钥（AES-256-GCM）──────────────────────────────
# 生成：openssl rand -base64 32
# 留空 = 不加密：所有敏感文本明文落库，启动时会打一条醒目 WARN（不阻断启动）。
# ⚠️ 启用前必须先应用 V31 迁移（把这些列加宽到 2048），否则长文本会报 1406 或被静默截断。
# ⚠️ 密钥丢失 = 这些字段永久不可读；必须进备份，且换密钥要用新的版本前缀分批重加密。
#DATA_ENC_KEY=

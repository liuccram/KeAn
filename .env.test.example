# 测试环境私有配置。复制为仓库根目录 .env.test 后填写。
# 会覆盖 .env 里的同名项。不要提交真实密钥。

SERVER_PORT=8080

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=kean_test
MYSQL_USERNAME=
MYSQL_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_EXPIRE_SECONDS=86400

# 对象存储：RustFS（S3 兼容）。旧名 MINIO_* 已改名为 STORAGE_*。
# 测试环境用独立桶，避免和开发数据混在一起。
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=kean-test

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=系统管理员

CORS_ALLOWED_ORIGINS=

MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=课安

SMS_ALLOW_CONSOLE=false
SMS_EXPOSE_CODE=false

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

TRUSTED_PROXIES=

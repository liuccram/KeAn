# 统一行尾与文本处理，避免 Windows 仓库产生整文件 diff。
# 规则自上而下匹配，后写的覆盖先写的。

* text=auto eol=lf

# Windows 脚本保留 CRLF，否则 PowerShell / cmd 可能解析异常
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 明确声明文本类型（本仓库含大量中文，确保按 UTF-8 处理）
*.java   text
*.sql    text
*.md     text
*.txt    text
*.yml    text
*.yaml   text
*.xml    text
*.json   text
*.properties text
*.ts     text
*.vue    text
*.js     text
*.css    text
*.scss   text
*.html   text

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip  binary
*.jar  binary

# 锁文件与生成物折叠显示
package-lock.json -diff linguist-generated
pnpm-lock.yaml    -diff linguist-generated
